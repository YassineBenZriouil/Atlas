# Copy to .env and fill in values for optional integrations.
# ATLAS core functionality never requires this file.

# Spotify integration (optional plugin, requires Spotify Premium + a Spotify
# Developer app). Leave unset to keep the Spotify plugin disabled.
ATLAS_SPOTIFY_CLIENT_ID=
ATLAS_SPOTIFY_CLIENT_SECRET=
ATLAS_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Cloud speech recognition (optional fallback after the OS-native recognizer,
# see docs/roadmap.md Phase 1). Any OpenAI-compatible /audio/transcriptions
# endpoint; set [speech] cloud_url / cloud_model in config to change provider.
# Leave unset to never send audio anywhere.
ATLAS_STT_API_KEY=
